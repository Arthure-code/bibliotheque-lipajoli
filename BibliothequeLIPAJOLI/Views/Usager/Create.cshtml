@model BibliothequeLIPAJOLI.ViewModels.UsagerCreateViewModel

@{
    ViewData["Title"] = "Ajouter un usager";
    ViewData["TitreAdresse"] = "Adresse";
}

<h2>Ajouter un usager</h2>

<form asp-action="Create" method="post" class="mt-3">
    <partial name="_Formulaire" model="Model" />

    <button type="submit" class="btn btn-success">Enregistrer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
