@model BibliothequeLIPAJOLI.ViewModels.UsagerCreateViewModel

@{
    ViewData["Title"] = "Modifier un usager";
    ViewData["TitreAdresse"] = "Adresse principale";
}

<h2>Modifier un usager</h2>

<form asp-action="Edit" method="post" class="mt-3">
    <partial name="_Formulaire" model="Model" />

    <button type="submit" class="btn btn-primary">Mettre à jour</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
