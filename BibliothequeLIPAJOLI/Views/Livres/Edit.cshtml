@model BibliothequeLIPAJOLI.ViewModels.LivreFormulaireViewModel

@{
    ViewData["Title"] = "Modifier un livre";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Livre.LivreID" />

    <div class="mb-3">
        <label asp-for="Livre.Titre" class="form-label"></label>
        <input asp-for="Livre.Titre" class="form-control" />
        <span asp-validation-for="Livre.Titre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Livre.Code" class="form-label"></label>
        <input asp-for="Livre.Code" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Livre.CategorieID" class="form-label">Catégorie</label>
        <select asp-for="Livre.CategorieID" asp-items="Model.Categories" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="Redactions" class="form-label">Auteurs</label>
        <select asp-for="Redactions" asp-items="Model.Auteurs" class="form-select" multiple="multiple">
            @foreach (var r in Model.Livre.Redactions ?? new List<Redaction>())
            {
                <option value="@r.AuteurID" selected="selected">@r.Auteur?.NomComplet</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Enregistrer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
